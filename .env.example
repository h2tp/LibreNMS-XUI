# --- Publication -------------------------------------------------------------
XUI_BIND=0.0.0.0
XUI_PORT=8095

# --- LibreNMS ----------------------------------------------------------------
# URL de LibreNMS vue depuis le conteneur
LIBRENMS_URL=http://192.0.2.10:8000
# URL utilisée par le navigateur pour les liens « ouvrir dans LibreNMS »
LIBRENMS_PUBLIC_URL=http://192.0.2.10:8000
# Jeton API (LibreNMS > Paramètres > API > Create API access token).
# Compte admin = toutes les fonctions ; compte global-read = consultation seule.
# Laisser vide pour que chaque utilisateur se connecte avec SON jeton.
LIBRENMS_TOKEN=
LIBRENMS_VERIFY_SSL=false
LIBRENMS_TIMEOUT=30

# --- Accès à l'interface -----------------------------------------------------
# Mode de connexion (seulement si LIBRENMS_TOKEN est défini) :
#   local    : compte unique UI_USERNAME / UI_PASSWORD
#   librenms : identifiants des comptes LibreNMS (base locale, LDAP, AD…).
#              admin = toutes les fonctions ; global-read = consultation seule ;
#              comptes limités à certains équipements refusés ; double authentification non gérée.
#              UI_USERNAME / UI_PASSWORD restent valables comme compte de secours (vider UI_PASSWORD pour l'interdire).
UI_AUTH=local
UI_USERNAME=admin
UI_PASSWORD=change-moi
SESSION_HOURS=12
# true derrière un reverse-proxy HTTPS
COOKIE_SECURE=false
# true = aucune authentification (réseau de confiance uniquement !)
AUTH_DISABLED=false
# true = bloque toute modification (POST/PUT/PATCH/DELETE)
READ_ONLY=false

# --- Base LibreNMS (facultatif, lecture seule) ---------------------------------
# Pour ce que l'API ne fournit pas ou fournit mal : ports supprimés (page Ports > Supprimés),
# CPU / mémoire / stockage (LibreNMS < 26.7), capteurs et libellés des capteurs d'état (voir README).
# Compte MySQL à créer avec le seul droit SELECT sur ces tables, par exemple :
#   CREATE USER 'xui'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON librenms.ports TO 'xui'@'%';
#   GRANT SELECT ON librenms.processors TO 'xui'@'%';
#   GRANT SELECT ON librenms.mempools TO 'xui'@'%';
#   GRANT SELECT ON librenms.storage TO 'xui'@'%';
#   GRANT SELECT ON librenms.sensors TO 'xui'@'%';
#   GRANT SELECT ON librenms.state_translations TO 'xui'@'%';
#   GRANT SELECT ON librenms.sensors_to_state_indexes TO 'xui'@'%';
# Base sur le même hôte que XUI et MySQL n'écoutant que sur 127.0.0.1 : passer par le socket Unix
# (LIBRENMS_DB_SOCKET=/run/mysqld/mysqld.sock, compte 'xui'@'localhost') en montant le dossier dans
# le conteneur, par exemple dans un docker-compose.override.yml :
#   services:
#     librenms-xui:
#       volumes:
#         - /run/mysqld:/run/mysqld:ro
# Laisser LIBRENMS_DB_HOST et LIBRENMS_DB_SOCKET vides pour désactiver.
LIBRENMS_DB_SOCKET=
LIBRENMS_DB_HOST=
LIBRENMS_DB_PORT=3306
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=
LIBRENMS_DB_PASSWORD=

# --- RRD (graphiques interactifs) ---------------------------------------------
# Dossier rrd de LibreNMS sur l'hôte, monté en lecture seule
RRD_PATH=/opt/librenms/rrd
# Si LibreNMS utilise rrdcached : RRDCACHED=rrdcached:42217
RRDCACHED=

# --- Temps réel (graphique « Temps réel » d'un port) ------------------------
# XUI lit les compteurs du port en SNMP (identifiants SNMP fournis par l'API LibreNMS).
# Le conteneur doit joindre les équipements en SNMP (UDP 161). false = désactivé.
REALTIME=true

# --- Agrégations (widgets CPU, RAM, stockage…) -------------------------------
# Requêtes simultanées max. vers LibreNMS pour les agrégations (garder < pm.max_children de LibreNMS)
AGG_CONCURRENCY=6
