# --- Publication -------------------------------------------------------------
XUI_BIND=0.0.0.0
XUI_PORT=8095

# --- LibreNMS ----------------------------------------------------------------
# URL de LibreNMS vue depuis le conteneur
LIBRENMS_URL=http://192.0.2.10:8000
# URL utilisée par le navigateur pour les liens « ouvrir dans LibreNMS »
LIBRENMS_PUBLIC_URL=http://192.0.2.10:8000
# Jeton API (LibreNMS > Paramètres > API > Create API access token).
# Compte admin = toutes les fonctions ; compte global-read = consultation seule.
# Laisser vide pour que chaque utilisateur se connecte avec SON jeton.
LIBRENMS_TOKEN=
LIBRENMS_VERIFY_SSL=false
LIBRENMS_TIMEOUT=30

# --- Accès à l'interface -----------------------------------------------------
# Mode de connexion (seulement si LIBRENMS_TOKEN est défini) :
#   local    : compte unique UI_USERNAME / UI_PASSWORD
#   librenms : identifiants des comptes LibreNMS (base locale, LDAP, AD…).
#              admin = toutes les fonctions ; global-read = consultation seule ;
#              comptes limités à certains équipements refusés ; double authentification non gérée.
#              UI_USERNAME / UI_PASSWORD restent valables comme compte de secours (vider UI_PASSWORD pour l'interdire).
UI_AUTH=local
UI_USERNAME=admin
UI_PASSWORD=change-moi
SESSION_HOURS=12
# true derrière un reverse-proxy HTTPS
COOKIE_SECURE=false
# true = aucune authentification (réseau de confiance uniquement !)
AUTH_DISABLED=false
# true = bloque toute modification (POST/PUT/PATCH/DELETE)
READ_ONLY=false

# --- RRD (graphiques interactifs) ---------------------------------------------
# Dossier rrd de LibreNMS sur l'hôte, monté en lecture seule
RRD_PATH=/opt/librenms/rrd
# Si LibreNMS utilise rrdcached : RRDCACHED=rrdcached:42217
RRDCACHED=

# --- Agrégations (widgets CPU, RAM, stockage…) -------------------------------
# Requêtes simultanées max. vers LibreNMS pour les agrégations (garder < pm.max_children de LibreNMS)
AGG_CONCURRENCY=6
